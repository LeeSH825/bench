  "key_finding": {
    "id": "CSR-F-001",
    "model": "split_knet",
    "summary": "DNN_SKalmanNet_GSS creates hn1_init/hn2_init with torch.randn as plain attributes, so state_dict() omits them even though initialize_hidden() restores every rollout from them. A checkpoint built only from state_dict() loads correct weights and still diverges after resume.",
    "detection": "every resume builds the resuming adapter with a different seed; Split diverged while KNet did not, and matched again when the seed was held equal",
    "resolution": "captured explicitly in extra_state, declared in required_conditional_state, and a payload lacking it is refused rather than resumed approximately",
    "side_effect": "warm start from model.pt is also not bitwise reproducible for split_knet; pre-existing and out of scope"
  },
