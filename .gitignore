# External datasets and download/prep outputs (must not be versioned).
external_data/
mock_external_data/
bench_data_raw/
bench_data_cache/

# Benchmark, training, and reporting outputs.
runs/
reports/

# Canonical Phase 0-1 research reports are version-controlled evidence.
!experiments/phase1a/reports/
!experiments/phase1a/reports/*.md
!experiments/phase1b/reports/
!experiments/phase1b/reports/*.md
!experiments/research_index/reports/
!experiments/research_index/reports/*.md

plots/
logs/
*.log
*.pid
*.start_time

# Python bytecode, test caches, and local tooling state.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.ipynb_checkpoints/

# Python packaging/build artifacts.
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Local environments and vendored runtime dependencies.
.venv/
venv/
env/
.basilisk_deps/

