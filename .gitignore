# Reproducible research payload trees; keep top-level final summary JSON visible.
experiments/**/results/**/records/
experiments/**/results/**/trajectories/
experiments/**/results/**/candidates/
experiments/**/results/**/debug/
experiments/**/results/**/pilot_manifest.json
experiments/**/results/**/search/search_manifest.json
experiments/**/manifests/

# Large preflight and agent runtime captures.
experiments/**/preflight_snapshots/**/*.patch
experiments/**/preflight_snapshots/**/*.z
experiments/**/preflight_snapshots/**/*.zlist
experiments/**/preflight_snapshots/**/*.tar.gz
experiments/**/agent_logs/**/*.patch

